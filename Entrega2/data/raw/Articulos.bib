	keywords = {Big Data, Feature extraction, Deep learning, Accuracy, Chatbots, ChatGPT, Detection algorithms, Detectors, Oral communication, Reinforcement learning, Social networking (online), synthetic abstracts, text synthesis detection},
	pages = {898--906},
	file = {Full Text PDF:files/28/Yu et al. - 2025 - CHEAT A Large-Scale Dataset for Detecting CHatGPT-writtEn AbsTracts.pdf:application/pdf},
}

