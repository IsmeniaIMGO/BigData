	keywords = {Support vector machines, Feature extraction, Deep learning, Internet of Things, Security, Convolutional neural networks, cyber-physical infrastructure, Cyber-physical systems, cyber-security, cyberattacks, IoT enabled cyber-physical systems, Metaheuristics, optimization technique},
