        <ex:ageRating>Mayores de 12</ex:ageRating>
        <ex:city>Armenia</ex:city>
        <ex:inTheaters>true</ex:inTheaters>
        <ex:distributor>Cine Colombia</ex:distributor>
    </schema:Movie>

